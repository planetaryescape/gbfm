{
  "name": "gbfm",
  "version": "2.121.3",
  "sideEffects": false,
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "scripts": {
    "dev": "cmdz",
    "dev:alchemy": "alchemy dev --stage=dev --config alchemy.run.ts --no-input",
    "dev:mobile": "bun --filter @gbfm/mobile start -- --lan",
    "dev:email": "bun run email:preview",
    "dev:otel": "bun run otel",
    "dev:d1": "bun --filter @gbfm/www dev:d1",
    "seed:local-users": "bun run scripts/seed-local-users.ts",
    "deploy": "bunx alchemy deploy --stage=dev",
    "deploy:prod": "bunx alchemy deploy --stage=prod --profile env-token --yes",
    "email:preview": "bun --filter @gbfm/email dev",
    "otel": "docker compose up jaeger -d",
    "release": "semantic-release",
    "typecheck": "tsgo --noEmit && bun --filter='*' typecheck",
    "test": "bun run test:alchemy && bun --filter @gbfm/observability test && bun --filter @gbfm/social-card test && cd packages/core && bun run test && cd ../theme && bun run test && cd ../player && bun run test && cd ../../apps/mobile && bun run test && cd ../pdf-generator && bun run test && cd ../server && bun run test && cd ../social-image && bun run test && cd ../cdn-router && bun run test",
    "test:alchemy": "vitest run alchemy",
    "test:www": "bun --filter @gbfm/www unit",
    "lint": "bun ./node_modules/oxlint/dist/cli.js alchemy alchemy.run.ts apps/*/src apps/cdn-router packages '*.{js,ts,tsx,jsx}' --no-error-on-unmatched-pattern",
    "lint:fix": "bun ./node_modules/oxlint/dist/cli.js alchemy alchemy.run.ts apps/*/src apps/cdn-router packages '*.{js,ts,tsx,jsx}' --fix --no-error-on-unmatched-pattern",
    "format": "node ./node_modules/oxfmt/dist/cli.js apps/*/src apps/cdn-router packages '*.{js,ts,tsx,jsx,json,css}' --write --no-error-on-unmatched-pattern",
    "format:check": "node ./node_modules/oxfmt/dist/cli.js apps/*/src apps/cdn-router packages '*.{js,ts,tsx,jsx,json,css}' --check --no-error-on-unmatched-pattern",
    "check": "bun run format && bun run lint:fix",
    "oxc:ci": "bun run format:check && bun run lint",
    "precommit": "bun run check && bun run typecheck",
    "ci": "bun run oxc:ci && bun run typecheck && bun run test && cd apps/www && bun run build",
    "prepare": "effect-tsgo patch --typescript --oxlint",
    "init:lefthook": "lefthook install"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1156.0",
    "@aws-sdk/s3-request-presigner": "3.1156.0",
    "@effect/platform-bun": "4.0.6",
    "@effect/platform-node": "4.0.6",
    "alchemy": "2.0.0-beta.83",
    "effect": "4.0.6",
    "gray-matter": "4.0.3",
    "vitest": "5.0.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "5.20261023.1",
    "@effect/tsgo": "0.56.0",
    "@oxlint/plugins": "1.89.0",
    "@semantic-release/changelog": "7.0.0",
    "@semantic-release/git": "11.0.1",
    "@semantic-release/github": "12.0.10",
    "@tsconfig/bun": "1.0.11",
    "@types/bun": "1.4.4",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "lefthook": "2.2.2",
    "madge": "8.0.0",
    "oxfmt": "0.74.0",
    "oxlint": "1.89.0",
    "oxlint-tsgolint": "7.0.2004",
    "portless": "0.15.10",
    "semantic-release": "25.0.9",
    "turbo": "2.11.10",
    "typescript": "7.0.2"
  },
  "overrides": {
    "lightningcss": "1.30.1"
  },
  "workspaces": [
    "packages/*",
    "apps/*"
  ],
  "trustedDependencies": [
    "aws-sdk",
    "esbuild",
    "sharp"
  ],
  "patchedDependencies": {
    "@spotify-effect/core@0.6.7": "patches/@spotify-effect%2Fcore@0.6.7.patch",
    "@spotify-effect/browser@0.6.7": "patches/@spotify-effect%2Fbrowser@0.6.7.patch",
    "harfbuzzjs@0.10.0": "patches/harfbuzzjs@0.10.0.patch",
    "@foldkit/ui@0.169.0": "patches/@foldkit%2Fui@0.169.0.patch"
  }
}
